    def Scope "mtl"
    {
        custom bool doubleSided = 1
        custom token familyName = "materialBind"

        def Material "debris1"
    {
        token outputs:surface.connect = </set_4/mtl/debris1/Principled_BSDF.outputs:surface>

        def Shader "Principled_BSDF"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.8, 0.8, 0.8)
            float inputs:metallic = 0
            float inputs:roughness = 0.5
            color3f inputs:diffuseColor.connect = </set_4/mtl/debris1/Image_Texture.outputs:rgb>
            float inputs:metallic.connect = </set_4/mtl/debris1/Image_Texture_004.outputs:b>
            float inputs:roughness.connect = </set_4/mtl/debris1/Image_Texture_003.outputs:g>
            normal3f inputs:normal.connect = </set_4/mtl/debris1/Image_Texture_002.outputs:rgb>
            float inputs:occlusion.connect = </set_4/mtl/debris1/Image_Texture_Occlusion.outputs:r>
                token outputs:surface
        }

        def Shader "uvmap"
        {
            uniform token info:id = "UsdPrimvarReader_float2"
            token inputs:varname = "st"
            float2 outputs:result
        }

        def Shader "Image_Texture"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @./t_set_4_base_color.png@
            token inputs:sourceColorSpace = "sRGB"
            float2 inputs:st.connect = </set_4/mtl/debris1/uvmap.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float3 outputs:rgb
        }

