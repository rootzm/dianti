    def Scope "mtl"
    {
        custom bool doubleSided = 1
        custom token familyName = "materialBind"

        def Material "Pipes01a"
    {
        token outputs:surface.connect = </dkg_Pipe_Set_01a/mtl/Pipes01a/Principled_BSDF.outputs:surface>

        def Shader "Principled_BSDF"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.8, 0.8, 0.8)
            float inputs:metallic = 0
            float inputs:roughness = 0.5
            color3f inputs:diffuseColor.connect = </dkg_Pipe_Set_01a/mtl/Pipes01a/Image_Texture.outputs:rgb>
            float inputs:metallic.connect = </dkg_Pipe_Set_01a/mtl/Pipes01a/Image_Texture_004.outputs:b>
            float inputs:roughness.connect = </dkg_Pipe_Set_01a/mtl/Pipes01a/Image_Texture_003.outputs:g>
            float inputs:occlusion.connect = </dkg_Pipe_Set_01a/mtl/Pipes01a/Image_Texture_Occlusion.outputs:r>
                token outputs:surface
        }

        def Shader "uvmap"
        {
            uniform token info:id = "UsdPrimvarReader_float2"
            token inputs:varname = "st"
            float2 outputs:result
        }

        def Shader "Image_Texture"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @./textures/Pipe_Group_01h_BaseColor.png@
            token inputs:sourceColorSpace = "sRGB"
            float2 inputs:st.connect = </dkg_Pipe_Set_01a/mtl/Pipes01a/uvmap.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float3 outputs:rgb
        }

        def Shader "Image_Texture_004"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @./textures/Pipe_Group_01h_ORM.png@
            token inputs:sourceColorSpace = "raw"
            float2 inputs:st.connect = </dkg_Pipe_Set_01a/mtl/Pipes01a/uvmap.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float outputs:b
        }

        def Shader "Image_Texture_Occlusion"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @./textures/Pipe_Group_01h_ORM.png@
            token inputs:sourceColorSpace = "raw"
            float2 inputs:st.connect = </dkg_Pipe_Set_01a/mtl/Pipes01a/uvmap.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float outputs:r
