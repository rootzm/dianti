    def Scope "mtl"
    {
        custom bool doubleSided = 1
        custom token familyName = "materialBind"

        def Material "cables"
    {
        token outputs:surface.connect = </cables_grouped/mtl/cables/Principled_BSDF.outputs:surface>

        def Shader "Principled_BSDF"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.8, 0.8, 0.8)
            float inputs:metallic = 0
            float inputs:roughness = 0.5
            color3f inputs:diffuseColor.connect = </cables_grouped/mtl/cables/Image_Texture.outputs:rgb>
            float inputs:metallic.connect = </cables_grouped/mtl/cables/Image_Texture_004.outputs:b>
            float inputs:roughness.connect = </cables_grouped/mtl/cables/Image_Texture_003.outputs:g>
            normal3f inputs:normal.connect = </cables_grouped/mtl/cables/Image_Texture_002.outputs:rgb>
            float inputs:occlusion.connect = </cables_grouped/mtl/cables/Image_Texture_Occlusion.outputs:r>
                token outputs:surface
        }

        def Shader "uvmap"
        {
            uniform token info:id = "UsdPrimvarReader_float2"
            token inputs:varname = "st"
            float2 outputs:result
        }

        def Shader "Image_Texture"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @./textures/cables_grouped_BaseColor.png@
            token inputs:sourceColorSpace = "sRGB"
            float2 inputs:st.connect = </cables_grouped/mtl/cables/uvmap.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float3 outputs:rgb
        }

        def Shader "Image_Texture_004"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @./textures/cables_grouped_ORM.png@
            token inputs:sourceColorSpace = "raw"
            float2 inputs:st.connect = </cables_grouped/mtl/cables/uvmap.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float outputs:b
        }

        def Shader "Image_Texture_Occlusion"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @./textures/cables_grouped_ORM.png@
            token inputs:sourceColorSpace = "raw"
            float2 inputs:st.connect = </cables_grouped/mtl/cables/uvmap.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float outputs:r
        }

        def Shader "Image_Texture_003"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @./textures/cables_grouped_ORM.png@
            token inputs:sourceColorSpace = "raw"
            float2 inputs:st.connect = </cables_grouped/mtl/cables/uvmap.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float outputs:g
        }
    

        def Shader "Image_Texture_002"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @./textures/cables_grouped_Normal.png@
            token inputs:sourceColorSpace = "raw"
            float2 inputs:st.connect = </cables_grouped/mtl/cables/uvmap.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float3 outputs:rgb
        }
    }
    }
}

