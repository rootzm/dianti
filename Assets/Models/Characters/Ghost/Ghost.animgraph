{
    "version": 2,
    "graphs": [
        {
            "name": "main",
            "type": "stateMachine",
            "outputs": [
                {
                    "name": "pose",
                    "type": "pose"
                }
            ],
            "startingState": "Grounded",
            "states": [
                {
                    "name": "Grounded",
                    "graph": "Grounded"
                },
                {
                    "name": "Jump Start",
                    "graph": "Jump Start"
                },
                {
                    "name": "Jump Loop",
                    "graph": "Jump Loop"
                },
                {
                    "name": "Jump Land",
                    "graph": "Jump Land"
                },
                {
                    "name": "AttackState",
                    "graph": "AttackState"
                },
                {
                    "name": "Hit",
                    "graph": "Hit"
                },
                {
                    "name": "Death",
                    "graph": "Death"
                }
            ],
            "transitions": [
                {
                    "from": "Grounded",
                    "to": "Jump Start",
                    "event": "JumpTrigger",
                    "blendTimeSec": 0.05
                },
                {
                    "from": "Grounded",
                    "to": "Jump Loop",
                    "blendTimeSec": 0.15,
                    "conditions": [
                        {
                            "variable": "IsRecentlyGrounded",
                            "value": false,
                            "operation": "equal"
                        },
                        {
                            "variable": "IsJumping",
                            "value": false,
                            "operation": "equal"
                        }
                    ]
                },
                {
                    "from": "Grounded",
                    "to": "AttackState",
                    "event": "Attack"
                },
                {
                    "from": "Grounded",
                    "to": "Hit",
                    "event": "GetHit"
                },
                {
                    "from": "Grounded",
                    "to": "Death",
                    "blendTimeSec": 0.05,
                    "conditions": [
                        {
                            "variable": "IsAlive",
                            "value": false,
                            "operation": "equal"
                        }
                    ]
                },
                {
                    "from": "Jump Start",
                    "to": "Jump Loop",
                    "blendTimeSec": 0.05,
                    "conditions": [
                        {
                            "variable": "__state_finished",
                            "value": true,
                            "operation": "equal"
                        }
                    ]
                },
                {
                    "from": "Jump Loop",
                    "to": "Jump Land",
                    "blendTimeSec": 0.15,
                    "conditions": [
                        {
                            "variable": "IsGrounded",
                            "value": true,
                            "operation": "equal"
                        }
                    ]
                },
                {
                    "from": "Jump Land",
                    "to": "Jump Start",
                    "event": "JumpTrigger",
                    "blendTimeSec": 0.05
                },
                {
                    "from": "Jump Land",
                    "to": "Grounded",
                    "blendTimeSec": 0.05,
                    "conditions": [
                        {
                            "variable": "__state_finished",
                            "value": true,
                            "operation": "equal"
                        },
                        {
                            "variable": "Speed",
                            "value": 0.01,
                            "operation": "lessOrEqual"
                        }
                    ]
                },
                {
                    "from": "Jump Land",
                    "to": "Grounded",
                    "blendTimeSec": 1.5,
                    "conditions": [
                        {
                            "variable": "Speed",
                            "value": 0.01,
                            "operation": "greater"
                        }
                    ]
                },
                {
                    "from": "AttackState",
                    "to": "Grounded",
                    "blendTimeSec": 0.2,
                    "conditions": [
                        {
                            "variable": "__state_finished",
                            "value": true,
                            "operation": "equal"
                        }
                    ]
                },
                {
                    "from": "AttackState",
                    "to": "AttackState",
                    "event": "Attack"
                },
                {
                    "from": "AttackState",
                    "to": "Hit",
                    "event": "GetHit"
                },
                {
                    "from": "AttackState",
                    "to": "Death",
                    "blendTimeSec": 0.05,
                    "conditions": [
                        {
                            "variable": "IsAlive",
                            "value": false,
                            "operation": "equal"
                        }
                    ]
                },
                {
                    "from": "Hit",
                    "to": "Grounded",
                    "blendTimeSec": 0.2,
                    "conditions": [
                        {
                            "variable": "__state_finished",
                            "value": true,
                            "operation": "equal"
                        }
                    ]
                },
                {
                    "from": "Hit",
                    "to": "AttackState",
                    "event": "Attack"
                },
                {
                    "from": "Hit",
                    "to": "Hit",
                    "event": "GetHit"
                },
                {
                    "from": "Hit",
                    "to": "Death",
                    "blendTimeSec": 0.05,
                    "conditions": [
                        {
                            "variable": "IsAlive",
                            "value": false,
                            "operation": "equal"
                        }
                    ]
                },
                {
                    "from": "Death",
                    "to": "Grounded",
                    "conditions": [
                        {
                            "variable": "IsAlive",
                            "value": true,
                            "operation": "equal"
                        }
                    ]
                }
            ]
        },
        {
            "name": "Grounded",
            "type": "dataflow",
            "inputs": [
                {
                    "name": "inputStatePhase",
                    "type": "float"
                }
            ],
            "outputs": [
                {
                    "name": "pose",
                    "type": "pose"
                }
            ],
            "nodes": [
                {
                    "name": "2D Blend Space",
                    "type": "blendSpace2DNode",
                    "members": {
                        "looping": true,
                        "xs": [
                            0,
                            -180,
                            -90,
                            90,
                            180,
                            -180,
                            -90,
                            0,
                            90,
                            180,
                            -180,
                            -90,
                            0,
                            90,
                            180
                        ],
                        "ys": [
                            0,
                            0,
                            0,
                            0,
                            0,
                            1.5,
                            1.5,
                            1.5,
                            1.5,
                            1.5,
                            5,
                            5,
                            5,
                            5,
                            5
                        ],
                        "anims": [
                            "Idle",
                            "Idle",
                            "Idle",
                            "Idle",
                            "Idle",
                            "Walk Back",
                            "Walk Left",
                            "Walk Fwd",
                            "Walk Right",
                            "Walk Back",
                            "Run Back",
                            "Run Left",
                            "Run Fwd",
                            "Run Right",
                            "Run Back"
                        ]
                    }
                },
                {
                    "name": "Read Float Variable",
                    "type": "getDynamicStoreValueFloat",
                    "members": {
                        "key": "MovementDirectionYaw"
                    }
                },
                {
                    "name": "Read Float Variable_1",
                    "type": "getDynamicStoreValueFloat",
                    "members": {
                        "key": "Speed"
                    }
                }
            ],
            "links": [
                [
                    "Read Float Variable:outputValue",
                    "2D Blend Space:x"
                ],
                [
                    "Read Float Variable_1:outputValue",
                    "2D Blend Space:y"
                ],
                [
                    "2D Blend Space:outputPose",
                    ":pose"
                ]
            ]
        },
