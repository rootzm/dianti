<Grid
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:noesis="clr-namespace:NoesisGUIExtensions"
  mc:Ignorable="d"
  d:DesignWidth="1920"
  d:DesignHeight="1080"
  x:Name="ComponentRoot" d:DataContext="HudGameControlsData">
  <noesis:LayoutScaler>
    <Grid>
      <Button x:Name="BtnFlash" Command="{Binding Path=events.OnClickBtnFlash}" Width="120" Height="120" Margin="0,0,200,200" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="0,0,0,0" Template="{DynamicResource BtnAnimNone}">
        <Grid Width="120" Height="120">
          <Image x:Name="BtnFlashBack" Source="/Root;component/Assets/UI/hud_game/btn_flash_back.png" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <Image x:Name="BtnFlashIconOff" Source="/Root;component/Assets/UI/hud_game/btn_flash_icon_off.png" Stretch="None" Visibility="{Binding Path=showIconFlashOff}"/>
          <Image x:Name="BtnFlashIconOn" Source="/Root;component/Assets/UI/hud_game/btn_flash_icon_on.png" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Path=showIconFlashOn}"/>
        </Grid>
      </Button>
      <Button x:Name="BtnAction" Command="{Binding Path=events.OnClickBtnAction}" Width="80" Height="95" Margin="0,0,80,100" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="0,0,0,0" Template="{DynamicResource BtnAnimNone}">
        <Grid Width="80" Height="95">
          <Image x:Name="BtnActionBackRun" Source="/Root;component/Assets/UI/hud_game/btn_action_back_run.png" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Path=showActionRun}"/>
          <Image x:Name="BtnActionBackSprint" Source="/Root;component/Assets/UI/hud_game/btn_action_back_sprint.png" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Path=showActionSprint}"/>
          <Image x:Name="BtnActionIconRun" Source="/Root;component/Assets/UI/hud_game/btn_action_run.png" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Path=showActionRun}"/>
          <Image x:Name="BtnActionIconSprint" Source="/Root;component/Assets/UI/hud_game/btn_action_sprint.png" Stretch="None" Margin="-4,0,6,0" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Path=showActionSprint}"/>
        </Grid>
      </Button>
      <Button x:Name="BtnUse" Command="{Binding Path=events.OnClickBtnUse}" Width="100" Height="100" Margin="0,0,240,50" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="0,0,0,0" Visibility="{Binding Path=showBtnUse}" Template="{DynamicResource BtnAnimNone}">
        <Grid Width="100" Height="100">
          <Image x:Name="BtnUseBack" Source="/Root;component/Assets/UI/hud_game/btn_use.png" Stretch="None"/>
          <Image x:Name="BtnUseIcon" Source="{Binding Path=btnUseIcon}" Stretch="Fill" Width="70" Height="70"/>
        </Grid>
      </Button>
      <Button x:Name="BtnOpenDepot" Command="{Binding Path=events.OnClickBtnOpenDepot}" Width="280" Height="100" Margin="0,0,393,449" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="0,0,0,0" Visibility="{Binding Path=showBtnOpenDepot}" Template="{DynamicResource BtnAnimNone}">
        <Grid Width="280" Height="100">
          <Image Source="/Root;component/Assets/UI/hud_game/hand.png" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Center"/>
          <Image Source="/Root;component/Assets/UI/hud_game/hint_back.png" Stretch="None" Width="330" Margin="59,0,-109,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
          <TextBlock Text="Open Depot" Margin="65,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="#FF000000" FontSize="26" FontWeight="Bold" TextWrapping="Wrap"/>
        </Grid>
      </Button>
      <Button x:Name="BtnPickup" Command="{Binding Path=events.OnClickBtnPickup}" Width="Auto" Height="200" Margin="802,0,0,74" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0,0,0,0" Visibility="{Binding Path=showBtnPickup}" Template="{DynamicResource BtnAnimNone}">
        <Grid Width="Auto" Height="200" HorizontalAlignment="Center" VerticalAlignment="Center">
          <noesis:NineSliceImage x:Name="BtnPickupFrame" ImageSource="/Root;component/Assets/UI/hud_game/backpack_frame_2.png" Slices="10,10,10,10" Width="110" Height="110" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Path=showBtnPickupDetails}"/>
          <Image x:Name="BtnPickupIcon" Source="{Binding Path=btnPickupIcon}" Width="98" Height="98" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Path=showBtnPickupDetails}"/>
          <Image x:Name="BtnPickupBatteryIcon" Source="/Root;component/Assets/UI/hud_game/battery_icon.png" Stretch="None" Margin="49,0,0,49" HorizontalAlignment="Left" VerticalAlignment="Bottom" Visibility="{Binding Path=showBtnPickupDetails}"/>
          <TextBlock x:Name="BtnPickupText" Text="{Binding Path=btnPickupTextPower}" Margin="70,0,0,50" HorizontalAlignment="Left" VerticalAlignment="Bottom" Foreground="#FFFFFFFF" FontSize="20" TextWrapping="NoWrap" Visibility="{Binding Path=showBtnPickupDetails}"/>
          <Image x:Name="BtnPickupHand" Source="/Root;component/Assets/UI/hud_game/hand.png" Stretch="None" Margin="-14,157,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
          <noesis:NineSliceImage x:Name="BtnPickupBack" ImageSource="/Root;component/Assets/UI/hud_game/hint_back.png" Slices="10,10,10,10" Width="302" Margin="45,156,-237,0" HorizontalAlignment="Left" VerticalAlignment="Center" Height="36"/>
          <TextBlock x:Name="BtnPickupTextBack" Text="{Binding Path=btnPickupTextName}" Margin="51,0,0,6" HorizontalAlignment="Left" VerticalAlignment="Bottom" Foreground="#FF000000" FontSize="26" FontWeight="Bold" TextWrapping="NoWrap"/>
        </Grid>
      </Button>
    </Grid>
  </noesis:LayoutScaler>
</Grid>
