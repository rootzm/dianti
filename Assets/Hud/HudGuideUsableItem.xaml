<Grid
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:noesis="clr-namespace:NoesisGUIExtensions"
  mc:Ignorable="d"
  d:DesignWidth="1920"
  d:DesignHeight="1080"
  x:Name="ComponentRoot" d:DataContext="HudGuideUsableItemData"
  IsHitTestVisible="False">
  <noesis:LayoutScaler>
    <Grid>
      <!-- Step1: Highlight the backpack slot where the usable item landed -->
      <!-- Slot 1 guide (leftmost slot) -->
      <Grid Visibility="{Binding Path=showStep1Slot1}" IsHitTestVisible="False">
        <noesis:NineSliceImage ImageSource="/Root;component/Assets/UI/hud_game/guide_highlight_frame.png" Slices="10,10,10,10" Width="120" Height="120" Margin="0,0,500,25" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
        <Grid Margin="0,0,500,150" HorizontalAlignment="Center" VerticalAlignment="Bottom">
          <Image Source="/Root;component/Assets/UI/hud_game/guide_dialog_back.png" Stretch="Fill" Width="420" Height="70"/>
          <TextBlock Text="This item is usable, Click to select the item" Foreground="#FFFFFF00" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="/Root;component/Assets/UI/fronts/#Silver"/>
        </Grid>
      </Grid>
      <!-- Slot 2 guide -->
      <Grid Visibility="{Binding Path=showStep1Slot2}" IsHitTestVisible="False">
        <noesis:NineSliceImage ImageSource="/Root;component/Assets/UI/hud_game/guide_highlight_frame.png" Slices="10,10,10,10" Width="120" Height="120" Margin="0,0,250,25" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
        <Grid Margin="0,0,250,150" HorizontalAlignment="Center" VerticalAlignment="Bottom">
          <Image Source="/Root;component/Assets/UI/hud_game/guide_dialog_back.png" Stretch="Fill" Width="420" Height="70"/>
          <TextBlock Text="This item is usable, Click to select the item" Foreground="#FFFFFF00" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="/Root;component/Assets/UI/fronts/#Silver"/>
        </Grid>
      </Grid>
      <!-- Slot 3 guide (center) -->
      <Grid Visibility="{Binding Path=showStep1Slot3}" IsHitTestVisible="False">
        <noesis:NineSliceImage ImageSource="/Root;component/Assets/UI/hud_game/guide_highlight_frame.png" Slices="10,10,10,10" Width="120" Height="120" Margin="0,0,0,25" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
        <Grid Margin="0,0,0,150" HorizontalAlignment="Center" VerticalAlignment="Bottom">
          <Image Source="/Root;component/Assets/UI/hud_game/guide_dialog_back.png" Stretch="Fill" Width="420" Height="70"/>
          <TextBlock Text="This item is usable, Click to select the item" Foreground="#FFFFFF00" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="/Root;component/Assets/UI/fronts/#Silver"/>
        </Grid>
      </Grid>
      <!-- Slot 4 guide -->
      <Grid Visibility="{Binding Path=showStep1Slot4}" IsHitTestVisible="False">
        <noesis:NineSliceImage ImageSource="/Root;component/Assets/UI/hud_game/guide_highlight_frame.png" Slices="10,10,10,10" Width="120" Height="120" Margin="250,0,0,25" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
        <Grid Margin="250,0,0,150" HorizontalAlignment="Center" VerticalAlignment="Bottom">
          <Image Source="/Root;component/Assets/UI/hud_game/guide_dialog_back.png" Stretch="Fill" Width="420" Height="70"/>
          <TextBlock Text="This item is usable, Click to select the item" Foreground="#FFFFFF00" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="/Root;component/Assets/UI/fronts/#Silver"/>
        </Grid>
      </Grid>
      <!-- Slot 5 guide (rightmost) -->
      <Grid Visibility="{Binding Path=showStep1Slot5}" IsHitTestVisible="False">
        <noesis:NineSliceImage ImageSource="/Root;component/Assets/UI/hud_game/guide_highlight_frame.png" Slices="10,10,10,10" Width="120" Height="120" Margin="500,0,0,25" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
        <Grid Margin="500,0,0,150" HorizontalAlignment="Center" VerticalAlignment="Bottom">
          <Image Source="/Root;component/Assets/UI/hud_game/guide_dialog_back.png" Stretch="Fill" Width="420" Height="70"/>
          <TextBlock Text="This item is usable, Click to select the item" Foreground="#FFFFFF00" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="/Root;component/Assets/UI/fronts/#Silver"/>
        </Grid>
      </Grid>

      <!-- Step2: Highlight the BtnUse (right bottom, Margin 0,0,240,50, 100x100) -->
      <Grid Visibility="{Binding Path=showStep2}" IsHitTestVisible="True">
        <noesis:NineSliceImage ImageSource="/Root;component/Assets/UI/hud_game/guide_highlight_frame.png" Slices="10,10,10,10" Width="120" Height="120" Margin="0,0,230,40" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False"/>
        <Button x:Name="BtnGuideDialog" Command="{Binding Path=events.OnClickBtnGuideDialog}" Margin="0,0,100,170" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="0" Template="{DynamicResource BtnAnimNone}" IsHitTestVisible="True">
          <Grid Width="420" Height="70">
            <Image Source="/Root;component/Assets/UI/hud_game/guide_dialog_back.png" Stretch="Fill"/>
            <TextBlock Text="Click the button to use the selected item." Foreground="#FFFFFF00" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="/Root;component/Assets/UI/fronts/#Silver"/>
          </Grid>
        </Button>
      </Grid>
    </Grid>
  </noesis:LayoutScaler>
</Grid>
