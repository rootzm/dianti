<Grid
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:noesis="clr-namespace:NoesisGUIExtensions"
  mc:Ignorable="d"
  d:DesignWidth="1920"
  d:DesignHeight="1080"
  x:Name="ComponentRoot" d:DataContext="HudGameCountdownData">
  <noesis:LayoutScaler>
    <Grid>
      <Grid Height="80" Width="280" Margin="0,30,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
        <Image Source="/Root;component/Assets/UI/hud_game/countdownBg.png" Stretch="Fill" Margin="0,-29,0,29" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        <StackPanel Orientation="Horizontal" Margin="0,-13,0,45" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Image Source="/Root;component/Assets/UI/hud_game/countdownClock.png" Width="40" Height="40" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <TextBlock Text="{Binding Path=textTime}" Foreground="#FFFFFFFF" FontSize="40" VerticalAlignment="Center" FontWeight="Bold"/>
        </StackPanel>
      </Grid>
    </Grid>
  </noesis:LayoutScaler>
</Grid>
