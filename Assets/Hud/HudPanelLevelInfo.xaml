<Grid
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:noesis="clr-namespace:NoesisGUIExtensions"
  mc:Ignorable="d"
  d:DesignWidth="1920"
  d:DesignHeight="1080"
  x:Name="ComponentRoot" d:DataContext="HudPanelLevelInfoData">
  <noesis:LayoutScaler>
    <Grid>
      <Image x:Name="Mask" Source="/Root;component/Assets/UI/hud_game/blank_black.png" Stretch="Fill" Opacity="0.9"/>
      <Image x:Name="Panel" Source="/Root;component/Assets/UI/hud_panel_victory/panel.png" Stretch="None" Margin="0,4,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <Image x:Name="Title" Source="/Root;component/Assets/UI/hud_panel_level_info/title.png" Stretch="None" Margin="0,0,84,518" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <TextBlock x:Name="TextLevelId" Text="{Binding Path=textFloor}" Margin="90,0,0,516" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFFFF" FontSize="40" FontWeight="Bold" TextWrapping="Wrap"/>
      <Image x:Name="PowerBack" Source="/Root;component/Assets/UI/hud_panel_level_info/power_back.png" Stretch="None" Margin="0,0,480,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <Image x:Name="Battery" Source="/Root;component/Assets/UI/hud_panel_level_info/battery.png" Stretch="None" Margin="0,8,475,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <TextBlock x:Name="TextPowerNeed" Text="Energy Requirement:" Margin="260,0,0,140" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFFFF" FontSize="48" TextWrapping="Wrap"/>
      <noesis:NineSliceImage x:Name="ValueBack" ImageSource="/Root;component/Assets/UI/hud_panel_level_info/value_back.png" Slices="10,10,10,10" Width="500" Height="100" Margin="260,92,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <TextBlock x:Name="TextValue" Text="{Binding Path=textEnergy}" Margin="250,92,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFFFF" FontSize="48" FontWeight="Bold" TextWrapping="Wrap"/>
      <noesis:NineSliceImage x:Name="DecoLine" ImageSource="/Root;component/Assets/UI/hud_panel_victory/deco_line.png" Slices="5,0,5,0" Width="900" Height="3" Margin="0,280,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <TextBlock x:Name="TextTimeLimit" Text="Time is limited! Gather resources quickly!" Margin="0,390,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFFFF" FontSize="48" TextWrapping="Wrap"/>
      <Button x:Name="BtnClose" Command="{Binding Path=events.OnClickBtnClose}" Width="100" Height="100" Margin="1120,0,0,540" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0,0,0,0" Template="{DynamicResource BtnAnimNone}">
        <Grid Width="100" Height="100" d:IsLocked="True">
          <Image Source="/Root;component/Assets/UI/hud_panel_depot/btn_close.png" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
      </Button>
    </Grid>
  </noesis:LayoutScaler>
</Grid>
