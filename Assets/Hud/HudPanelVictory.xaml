<Component xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:noesis="clr-namespace:NoesisGUIExtensions"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           mc:Ignorable="d"
           d:DesignWidth="1920" d:DesignHeight="1080" d:DataContext="HudPanelVictoryData">
  <noesis:LayoutScaler ReferenceResolution="1920,1080">
    <Grid>
      <Image x:Name="Mask" Source="/Root;component/Assets/UI/hud_game/blank_black.png" Stretch="Fill" Opacity="0.9"/>
      <Image x:Name="Panel" Source="/Root;component/Assets/UI/hud_panel_victory/panel.png" Stretch="None" Margin="0,0,0,150" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <Image x:Name="Title" Source="/Root;component/Assets/UI/hud_panel_victory/title.png" Stretch="None" Margin="0,0,0,672" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <TextBlock x:Name="Desc" noesis:RichText.Text="Elevator requirements met. Proceed
&#x0A;to the next floor!" Margin="0,0,0,160" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFFFF" FontSize="54" TextAlignment="Center" TextWrapping="Wrap"/>
      <noesis:NineSliceImage x:Name="DecoLine" ImageSource="/Root;component/Assets/UI/hud_panel_victory/deco_line.png" Slices="5,0,5,0" Width="900" Height="3" Margin="0,80,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <Button x:Name="BtnNext" Command="{Binding Path=events.OnClickBtnNext}" Width="502" Height="183" Margin="0,660,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0,0,0,0" Template="{DynamicResource BtnAnimNone}">
        <Grid Width="502" Height="183">
          <Image Source="/Root;component/Assets/UI/hud_panel_charge/btn_charge.png" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <TextBlock Text="NEXT" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF503202" FontSize="48" FontWeight="Bold" TextWrapping="Wrap"/>
        </Grid>
      </Button>
    </Grid>
  </noesis:LayoutScaler>
</Component>
