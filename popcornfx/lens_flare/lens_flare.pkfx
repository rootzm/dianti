CParticleNodeScript	$9CEA2A94
{
	CustomName = {
		"@eng:Fade on stop",
	};
	ExecStage = Evolve;
	InputPins = {
		"$95F9282A",
		"$24C6052E",
	};
	OutputPins = {
		"$F5201DF0",
	};
	WorkspacePosition = int2(-2310, 1408);
	Expression = "bool	isStopped = !effect.isRunning();
float	fadeOut = 1 - LifeRatioSinceStop;
float 	lrStep = select(effect.dt / DeathDelay, infinity, (DeathDelay == 0.f));
LifeRatioSinceStop = saturate(LifeRatioSinceStop + select(0, lrStep, isStopped));
self.kill(LifeRatioSinceStop == 1);
";
}
