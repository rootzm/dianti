CParticleNodeAnnotation	$CDDE95B2
{
	CustomName = {
		"@eng:ai_data",
	};
	Description = {
		"@eng:effect_name: Electric Sparks\\n\\neffect_description: A continuous electrical sparking effect with bright cyan-blue sparks that appear randomly at various positions over time. Features probability-based triggering for organic spark timing, optional bolt trails for arcing effects, and configurable flash intensity. The sparks create a persistent electrical ambiance with flickering, energetic particles that simulate live electrical current or charged equipment.\\n\\nstyle: stylized\\n\\nDescriptors: continuous, flickering, random, energetic, electric, ambient, charged, technical, industrial, sci-fi\\n\\ntags: electric, spark, sparks, electricity, energy, zap, flicker, continuous, ambient, charged, power, voltage, current, electrical, arc, discharge, cyan, blue, bright, technical, industrial, sci-fi, equipment, power source, generator, damaged wiring, live wire, electrified\\n\\n---\\n\\nSuggested Presets:\\n\\n[Idle Hum] global_scale=0.5, spark_flash_enable=false, bolts_enable=false, trigger_probability=4\\nSubtle background sparking for powered equipment at rest.\\n\\n[Active Circuit] global_scale=1.0, spark_flash_enable=true, bolts_enable=false, trigger_probability=8\\nStandard electrical activity for active machinery or conduits.\\n\\n[Overloaded] global_scale=1.5, spark_flash_enable=true, bolts_enable=true, bolts_length=3.0, trigger_probability=15\\nIntense sparking for overloaded or damaged electrical systems.\\n\\n[Arc Welder] global_scale=0.8, spark_flash_enable=true, bolts_enable=true, bolts_length=2.0, color_blue=false\\nWelding-style sparks with visible arc trails.\\n\\n[Sci-Fi Power Core] global_scale=1.2, spark_flash_enable=true, bolts_enable=true, bolts_length=4.0, color_blue=true, trigger_probability=20\\nHigh-energy sci-fi power source with frequent dramatic arcs.\\n\\n---\\n\\nAlternate Use Cases:\\n\\n[Damaged Robot] Attach to mechanical joints to show electrical damage or malfunction.\\n\\n[Forcefield Impact] Use at impact points where objects contact an energy barrier.\\n\\n[Tesla Coil] Scale up with high bolt length for decorative electrical displays.\\n\\n[Hacking Interface] Small scale, high probability for cyberpunk hacking sequences.\\n",
	};
	WorkspacePosition = int2(-3916, -132);
	PostItType = Blue;
	PostIt = true;
	SelfSize = int2(560, 436);
}
